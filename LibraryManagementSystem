//Helper Function
void waitForDoubleEnter(){
    std::cout << "[Press Enter twice to confirm]";
    std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
    std::cin.get();
}

class Book {
private:
    //Data about book
    int BookID;
    std::string Title;
    std::string Author;
    int Year;
    enum class Category {
        Science, History, Fiction, Psychology, Technology, Other
    };
    Category category;
    bool Available;

    //Converts enum to string
    std::string getCategoryString(Category c) const {
        switch (c) {
        case Category::Science: return "Science";
        case Category::History: return "History";
        case Category::Fiction: return "Fiction";
        case Category::Psychology: return "Psychology";
        case Category::Technology: return "Technology";
        case Category::Other: return "Other";
        default: return "Unknown";
        }
    }

public:
    //Constructor
    Book(int id = 0, std::string t = "", std::string a = "", int y = 0, int c = 0) {
        BookID = id;
        Title = t;
        Author = a;
        Year = y;
        Available = true;
        category = static_cast<Category>(c);
    }

    void setAvailable(bool status) {
        Available = status;
    }

    //Overload << operator
    void print(std::ostream& output) const {
        output/*counts as std::cout*/ << BookID << ", " << Title << ", " << Author << ", " << Year << ", " << getCategoryString(category) << ", " << (Available ? "Available" : "Borrowed");
    }

    int getID() const { return BookID; }
    Category getCat() const { return category; }
    std::string getTitle() const { return Title; }
    int getYear() const { return Year; }
    bool getAvailability() const { return Available; }
};

//Overload << operator
std::ostream& operator<<(std::ostream& output, const Book& b) {
    b.print(output);
    return output;
}

//Linked List Nodes
template <typename T>
class Node {
public:
    T data;
    Node* next;
    Node* prev;
    //Constructor
    Node(const T& d = T(), Node* n = nullptr, Node* p = nullptr) : data(d), next(n), prev(p) {};
};

template <typename T>
class DoublyLinkedList {
private:
    Node<T>* dummyHead;
    Node<T>* dummyTail;
    std::unordered_map<int, Node<T>*> indexMap;

public:
    //Constructor functions
    DoublyLinkedList() {
        dummyHead = new Node<T>(T(), nullptr);
        dummyTail = new Node<T>(T(), nullptr);
        dummyHead->next = dummyTail;
        dummyTail->prev = dummyHead;
    }
    Node<T>* zeroth() { return dummyHead; }
    Node<T>* first() { return dummyHead->next; }
    const Node<T>* first() const { return dummyHead->next; }
    
    //Destructor functions
    bool isEmpty() const { return dummyHead->next == dummyTail; }
    
    void remove(Node<T>* target) {
        target->prev->next = target->next;
        target->next->prev = target->prev;
        delete target;
    }
    
    void makeEmpty() {
        while (!isEmpty()) {
            remove(first());
        }
    }
    
    ~DoublyLinkedList() {
        makeEmpty();
        delete dummyHead;
        delete dummyTail;
    }
    
    //Library Management functions
    bool addBook(const T& newData) {
        if (indexMap.find(newData.getID()) != indexMap.end()) {
            return false; // ID already exists
        }
        Node<T>* newNode = new Node<T>(newData);

        Node<T>* after = dummyTail;
        Node<T>* before = dummyTail->prev;

        newNode->prev = before;
        newNode->next = after;

        before->next = newNode;
        after->prev = newNode;

        indexMap[newData.getID()] = newNode;
        return true;
    }

    bool removeBook(int id) {
        Node<T>* target = searchBook(id);
        
        if (target == nullptr) {
            return false;
        }

        // Erase from Map first (before the node is deleted)
        indexMap.erase(id);

        // Use your existing helper function to unlink and delete the node
        remove(target);
        
        return true;
    }

    //Search by ID only
    Node<T>* searchBook(int targetID) {
        auto it = indexMap.find(targetID);
        if (it != indexMap.end()) {
            return it->second;
        }
        return nullptr;
    }

    //Search by ID, Category, and Title
    Node<T>* searchBook(int id, int cat, const std::string& title) {
        Node<T>* target = searchBook(id);
        
        if (target != nullptr) {
            if (static_cast<int>(target->data.getCat()) == cat && 
                target->data.getTitle() == title) {
                return target; 
            }
        }
        return nullptr; 
    }

    void displayAll() const {
        if (isEmpty()) {
            std::cout << "This library is empty.\n";
            return;
        }

        std::cout << "  Displaying all books in this library.   \n";
        Node<T>* current = dummyHead->next;
        while (current != dummyTail) {
            std::cout << current->data << "\n";
            current = current->next;
        }
    }

};

void addBook(DoublyLinkedList<Book>* activeLibrary) {
    int id, year, catInt;
    std::string title, author;

    std::cout << "Input book data\nBookID: \n"; std::cin >> id;
    waitForDoubleEnter();

    std::cout << "Title: ";
    std::getline(std::cin, title);
    waitForDoubleEnter();

    std::cout << "\nAuthor: ";
    std::getline(std::cin, author);
    waitForDoubleEnter();

    std::cout << "\nYear: "; std::cin >> year;
    waitForDoubleEnter();

    std::cout << "\nCategories: 0=Science, 1=History, 2=Fiction, 3=Psychology, 4=Technology, 5=Other\nCategory: ";
    std::cin >> catInt;
    waitForDoubleEnter();

    if (activeLibrary->addBook(Book(id, title, author, year, catInt))) {
        std::cout << "Book added successfully.\n";
    } else {
        std::cout << "Error: A book with ID " << id << " already exists.\n";
    }
}

void removeBook(DoublyLinkedList<Book>* activeLibrary) {
    if (activeLibrary->isEmpty()) {
        std::cout << "Error: The library is empty. Nothing to remove.\n";
        return;
    }
    int removeID;
    std::cout << "Enter BookID to remove: "; std::cin >> removeID;
    waitForDoubleEnter();

    if (activeLibrary->removeBook(removeID)) {
        std::cout << "Successfully removed.\n";
    }
    else {
        std::cout << "Error: BookID not found in library.\n";
    }
}

void searchBook(DoublyLinkedList<Book>* activeLibrary) {
    int id, intCat;
    std::string title;

    std::cout << "Enter BookID: "; std::cin >> id;
    waitForDoubleEnter();

    std::cout << "\nEnter category (0-5): "; std::cin >> intCat;
    waitForDoubleEnter();

    std::cout << "\nEnter title: "; std::getline(std::cin, title);
    waitForDoubleEnter();

    Node<Book>* foundNode = activeLibrary->searchBook(id, intCat, title);

    if (foundNode != nullptr) {
        std::cout << "\nMatch found:\n" << foundNode->data << "\n";
    }
    else {
        std::cout << "\nError: No book matches those exact details.\n";
    }
}

void borrowBook(DoublyLinkedList<Book>* activeLibrary) {
    if (activeLibrary->isEmpty()) {
        std::cout << "Error: The library is empty. No books to borrow.\n";
        return;
    }

    int id;
    std::cout << "Enter BookID to borrow: "; std::cin >> id;
    waitForDoubleEnter();

    Node<Book>* target = activeLibrary->searchBook(id);
    if (target != nullptr) {
        if (target->data.getAvailability()) {
            target->data.setAvailable(false);
            std::cout << target->data.getTitle() << " successfully borrowed.\n";
        }
        else {
            std::cout << "Sorry, this book is already borrowed. \n";
        }
    }
    else {
        std::cout << "Error: BookID not found.\n";
    }
}

void returnBook(DoublyLinkedList<Book>* activeLibrary) {
    if (activeLibrary->isEmpty()) {
        std::cout << "Error: The library is empty. No books to return.\n";
        return;
    }
    
    int id;
    std::cout << "Enter BookID to return: "; std::cin >> id;
    waitForDoubleEnter();
    
    Node<Book>* target = activeLibrary->searchBook(id);
    if (target != nullptr) {
        if (!target->data.getAvailability()) {
            target->data.setAvailable(true);
            std::cout << target->data.getTitle() << " successfully returned.\n";
        }
        else {
            std::cout << "This book was not borrowed.\n";
        }
    }
    else {
        std::cout << "Error: BookID not found.\n";
    }
}

void displayMenu() {
    std::vector<std::string> options = {
        "1. Add a new book",
        "2. Remove book",
        "3. Search for book",
        "4. Display all books",
        "5. Borrow a book",
        "6. Return a book",
        "7. Exit program"
    };
    std::cout << "\n";
    for (std::string s : options) {
        std::cout << s << "\n";
    }
}

int main() {
    std::cout << "========================================\n";
    std::cout << "    LIBRARY MANAGEMENT SYSTEM SETUP     \n";
    std::cout << "========================================\n";
    std::cout << "INSTRUCTIONS:\n";
    std::cout << "- After typing ANY input, you must press\n";
    std::cout << "  ENTER twice to confirm and save it.\n";
    std::cout << "========================================\n\n";
    
    std::map<std::string, DoublyLinkedList<Book>*> librarySystem;
    std::string libName;
    std::cout << "Enter new library name: "; std::getline(std::cin, libName);
    waitForDoubleEnter();

    librarySystem[libName] = new DoublyLinkedList<Book>();
    DoublyLinkedList<Book>* activeLibrary = librarySystem[libName];
    std::cout << "Library '" << libName << "' created. \n";

    bool keepRunning = true;
    while (keepRunning) {
        displayMenu();
        int option;
        std::cout << "Input option number: "; std::cin >> option; 
        if (std::cin.fail()) {
            std::cin.clear();
            std::cin.ignore(10000, '\n');
            continue;
        }
        waitForDoubleEnter();
        
        switch (option) {
        case 1:addBook(activeLibrary); break;
        case 2:removeBook(activeLibrary); break;
        case 3:searchBook(activeLibrary); break;
        case 4:activeLibrary->displayAll(); break;
        case 5:borrowBook(activeLibrary); break;
        case 6:returnBook(activeLibrary); break;
        case 7:
            keepRunning = false;
            break;
        default:
            std::cout << "Invalid input. Please enter a number 1-7.\n";
        }
    }
    for (auto const& pair : librarySystem) {
        delete pair.second;
    }
    std::cout << "Memory cleared. Exiting program.\n";
    std::this_thread::sleep_for(std::chrono::seconds(3));
    return 0;
}