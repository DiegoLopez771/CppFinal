class Book {
private:
    //Data about book
    int BookID;
    std::string Title;
    std::string Author;
    int Year;
    enum class Category {
        Science, History, Fiction, Psychology, Technology, Other
    };
    Category category;
    bool Available;

    //Converts enum to string
    std::string getCategoryString(Category c) const {
        switch (c) {
        case Category::Science: return "Science";
        case Category::History: return "History";
        case Category::Fiction: return "Fiction";
        case Category::Psychology: return "Psychology";
        case Category::Technology: return "Technology";
        case Category::Other: return "Other";
        default: return "Unknown";
        }
    }

public:
    //Constructor
    Book(int id = 0, std::string t = "", std::string a = "", int y = 0, int c = 0, bool avail = true) {
        BookID = id;
        Title = t;
        Author = a;
        Year = y;
        Available = avail;
        category = static_cast<Category>(c);
    }

    void setAvailable(bool status) {
        Available = status;
    }

    //Overload << operator
    void print(std::ostream& output) const {
        output/*counts as std::cout*/ << BookID << ", " << Title << ", " << Author << ", " << Year << ", " << getCategoryString(category) << ", " << (Available ? "Available" : "Borrowed");
    }

    int getID() const { return BookID; }
    Category getCat() const { return category; }
    std::string getTitle() const { return Title; }
    int getYear() const { return Year; }
    bool getAvailability() const { return Available; }
};

//Overload << operator
std::ostream& operator<<(std::ostream& output, const Book& b) {
    b.print(output);
    return output;
}

//Linked List Nodes
template <typename T>
class Node {
public:
    T data;
    Node* next;
    Node* prev;
    //Constructor
    Node(const T& d = T(), Node* n = nullptr, Node* p = nullptr) : data(d), next(n), prev(p) {};
};

template <typename K, typename V>
class HashNode{
public:
    K key;
    V value;
    HashNode* next;

    //Constructor
    HashNode(K k, V v) : key(k), value(v), next(nullptr) {}
};
template <typename K, typename V>
class HashTable{
private:
    HashNode<K, V>** table;
    int capacity;
    int currentSize;

    //The Hash Function: Maps a key to an array index
    int hashFunction(K key) const{
        return key%capacity;
    }

public:
    //Constructor
    HashTable(int cap = 100){
        capacity = cap;
        current size = 0;
        table = new HashNode<K, V>*[capacity];

        //Initialize all buckets to nullptr
        for(int i = 0; i < capacity; i++){
            table[i] = nullptr;
        }
    }

    //Destructor
    ~HashTable(){
        for(int i = 0; i < capacity; i++){
            HashNode<K, V>* entry = table[i];
            while(entry != nullptr){
                HashNode<K, V>* prev = entry;
                entry = entry->next;
                delete prev;
            }
        }
        delete[] table;
    }

    // INSERT: Add a new Key-Value pair
    bool insert(K key, V value) {
        int hashIndex = hashFunction(key);
        HashNode<K, V>* prev = nullptr;
        HashNode<K, V>* entry = table[hashIndex];

        // Check for duplicate keys in this bucket's chain
        while (entry != nullptr) {
            if (entry->key == key) {
                return false; // Key already exists, fail the insertion
            }
            prev = entry;
            entry = entry->next;
        }

        // If we reach here, the key is unique. Insert it.
        entry = new HashNode<K, V>(key, value);
        
        if (prev == nullptr) {
            // It's the first item in this bucket
            table[hashIndex] = entry;
        } else {
            // Add it to the end of the existing chain
            prev->next = entry;
        }
        currentSize++;
        return true;
    }

    // SEARCH: Find a value by its Key
    V search(K key) {
        int hashIndex = hashFunction(key);
        HashNode<K, V>* entry = table[hashIndex];

        // Walk through the chain at this bucket looking for the key
        while (entry != nullptr) {
            if (entry->key == key) {
                return entry->value; // Match found! Return the value.
            }
            entry = entry->next;
        }
        
        // If we exit the loop, the key wasn't found.
        return nullptr; 
    }

    // REMOVE: Delete a Key-Value pair
    bool remove(K key) {
        int hashIndex = hashFunction(key);
        HashNode<K, V>* prev = nullptr;
        HashNode<K, V>* entry = table[hashIndex];

        while (entry != nullptr) {
            if (entry->key == key) {
                // We found the node to delete
                if (prev == nullptr) {
                    // It was the first node in the bucket
                    table[hashIndex] = entry->next;
                } else {
                    // It was somewhere in the middle/end of the chain
                    prev->next = entry->next;
                }
                delete entry;
                currentSize--;
                return true;
            }
            prev = entry;
            entry = entry->next;
        }
        return false; // Key not found
    }

    // Utility
    bool isEmpty() const {
        return currentSize == 0;
    }
};

template <typename T>
class DoublyLinkedList {
private:
    Node<T>* dummyHead;
    Node<T>* dummyTail;
    HashTable<int, Node<T>*> indexMap;

public:
    //Constructor functions
    DoublyLinkedList() {
        dummyHead = new Node<T>(T(), nullptr);
        dummyTail = new Node<T>(T(), nullptr);
        dummyHead->next = dummyTail;
        dummyTail->prev = dummyHead;
    }
    Node<T>* zeroth() { return dummyHead; }
    Node<T>* first() { return dummyHead->next; }
    const Node<T>* first() const { return dummyHead->next; }
    
    //Destructor functions
    bool isEmpty() const { return dummyHead->next == dummyTail; }
    
    void remove(Node<T>* target) {
        target->prev->next = target->next;
        target->next->prev = target->prev;
        delete target;
    }
    
    void makeEmpty() {
        while (!isEmpty()) {
            remove(first());
        }
    }
    
    ~DoublyLinkedList() {
        makeEmpty();
        delete dummyHead;
        delete dummyTail;
    }
    
    //Library Management functions
    bool addBook(const T& newData) {
        if (indexMap.search(newData.getID()) != indexMap.end()) {
            return false; // ID already exists
        }
        Node<T>* newNode = new Node<T>(newData);

        Node<T>* after = dummyTail;
        Node<T>* before = dummyTail->prev;

        newNode->prev = before;
        newNode->next = after;

        before->next = newNode;
        after->prev = newNode;

        indexMap.insert(newData.getID(), newNode);
        return true;
    }

    bool removeBook(int id) {
        Node<T>* target = searchBook(id);
        
        if (target == nullptr) {
            return false;
        }

        // Erase from Map first (before the node is deleted)
        indexMap.remove(id);

        // Use your existing helper function to unlink and delete the node
        remove(target);
        
        return true;
    }

    //Search functions
    Node<T>* searchBook(int targetID) {
        return indexMap.search(targetID);
    }

    Node<T>* searchBook(const std::string& title) {
        Node<T>* current = dummyHead->next;
        
        while (current != dummyTail) {
            if (current->data.getTitle() == title) {
                return current; // Match found
            }
        current = current->next;
        }
        return nullptr;
    }

    void searchBookByCat(int cat){
        Node<T>* current = dummyHead->next;
        bool foundAny = false;

        while (current != dummyTail) {
            if (static_cast<int>(current->data.getCat()) == cat) {
                std::cout << current->data << "\n";
                foundAny = true;
            }
            current = current->next;
        }
        if(!foundAny){
            std::cout << "No books found in this category.\n";
        }
    }

    void displayAll() const {
        if (isEmpty()) {
            std::cout << "This library is empty.\n";
            return;
        }

        std::cout << "  Displaying all books in this library.   \n";
        Node<T>* current = dummyHead->next;
        while (current != dummyTail) {
            std::cout << current->data << "\n";
            current = current->next;
        }
    }
};

void addBook(DoublyLinkedList<Book>* activeLibrary) {
    int id, year, catInt;
    std::string title, author;

    std::cout << "Input book data\nBookID: \n"; std::cin >> id;
    waitForDoubleEnter();

    std::cout << "Title: ";
    std::getline(std::cin, title);
    waitForDoubleEnter();

    std::cout << "\nAuthor: ";
    std::getline(std::cin, author);
    waitForDoubleEnter();

    std::cout << "\nYear: "; std::cin >> year;
    waitForDoubleEnter();

    std::cout << "\nCategories: 0=Science, 1=History, 2=Fiction, 3=Psychology, 4=Technology, 5=Other\nCategory: ";
    std::cin >> catInt;
    waitForDoubleEnter();

    if (activeLibrary->addBook(Book(id, title, author, year, catInt))) {
        std::cout << "Book added successfully.\n";
    } else {
        throw std::invalid_argument("A book with ID " + std::to_string(id) + " already exists.");
    }
}

void removeBook(DoublyLinkedList<Book>* activeLibrary) {
    if (activeLibrary->isEmpty()) {
        throw std::runtime_error("The library is empty. Nothing to remove.");
        return;
    }
    int removeID;
    std::cout << "Enter BookID to remove: "; std::cin >> removeID;
    waitForDoubleEnter();

    if (activeLibrary->removeBook(removeID)) {
        std::cout << "Successfully removed.\n";
    }
    else {
        throw std::invalid_argument("BookID not found in library.");
    }
}

enum class SearchChoice {
    byID = 1,
    byTitle = 2,
    byCategory = 3
};
void searchBook(DoublyLinkedList<Book>* activeLibrary) {
    if(activeLibrary->isEmpty()){
        throw std::runtime_error("The library is empty. Nothing to search.");
    }
    int searchType;
    std::cout << "Search by:\n1. Book ID\n2. Title\n3. Category\nEnter choice (1-3): ";
    std::cin >> searchType;
    waitForDoubleEnter();

    SearchChoice choice = static_cast<SearchChoice>(searchType);

    switch(choice){
        case SearchChoice::byID:{
            int id;
            std::cout << "Enter BookID: "; std::cin >> id;
            waitForDoubleEnter();
            
            Node<Book>* foundNode = activeLibrary->searchBook(id);
            if (foundNode != nullptr) {
                std::cout << "\nMatch found:\n" << foundNode->data << "\n";
            } else {
                throw std::invalid_argument("Book not found.");
            }
            break;
        }
        case SearchChoice::byTitle:{
            std::string title;
            std::cout << "Enter Title: "; std::getline(std::cin, title);
            waitForDoubleEnter();
            
            Node<Book>* foundNode = activeLibrary->searchBook(title);
            if (foundNode != nullptr) {
                std::cout << "\nMatch found:\n" << foundNode->data << "\n";
            } else {
                throw std::invalid_argument("Book not found.");
            }
            break;
        }
        case SearchChoice::byCategory:{
            int intCat;
            std::cout << "Enter category (0=Science, 1=History, 2=Fiction, 3=Psychology, 4=Technology, 5=Other): "; 
            std::cin >> intCat;
            waitForDoubleEnter();
            
            activeLibrary->searchBookByCat(intCat);
            break;
        }
        default:
            throw std::invalid_argument("Invalid selection. Must be 1-3.");
    }
}

void borrowBook(DoublyLinkedList<Book>* activeLibrary) {
    if (activeLibrary->isEmpty()) {
        throw std::runtime_error("The library is empty. No books to borrow.");
    }

    int id;
    std::cout << "Enter BookID to borrow: "; std::cin >> id;
    waitForDoubleEnter();

    Node<Book>* target = activeLibrary->searchBook(id);
    if (target != nullptr) {
        if (target->data.getAvailability()) {
            target->data.setAvailable(false);
            std::cout << target->data.getTitle() << " successfully borrowed.\n";
        }
        else {
            throw std::runtime_error("Sorry, this book is already borrowed.");
        }
    }
    else {
        throw std::invalid_argument("BookID not found.");
    }
}

void returnBook(DoublyLinkedList<Book>* activeLibrary) {
    if (activeLibrary->isEmpty()) {
        throw std::runtime_error("The library is empty. No books to return.");
    }

    int id;
    std::cout << "Enter BookID to return: "; std::cin >> id;
    waitForDoubleEnter();
    
    Node<Book>* target = activeLibrary->searchBook(id);
   if (target != nullptr) {
        if (!target->data.getAvailability()) {
            target->data.setAvailable(true);
            std::cout << target->data.getTitle() << " successfully returned.\n";
        }
        else {
            throw std::runtime_error("This book was not borrowed.");
        }
    }
    else {
        throw std::invalid_argument("BookID not found.");
    }
}

